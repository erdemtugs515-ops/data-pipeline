import sqlite3

conn = sqlite3.connect("class_task.db")
cursor = conn.cursor()

cursor.execute(""" CREATE TABLE IF NOT EXISTS teachers  ( id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, subject TEXT, age INTEGER)""")
cursor.execute(""" INSERT INTO teachers (name, subject, age) VALUES (?, ?, ?)""", ("Jane Doe", "math", 36))

conn.commit()
cursor.execute("SELECT * FROM teachers")
rows = cursor.fetchall()

for row in rows:
    print(row)

conn.close()

